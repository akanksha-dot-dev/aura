# ═════════════════════════════════════════════════════════════════════════════
# AURA — Voice AI Incident Commander
# Environment Configuration Template
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local:
#      cp .env.example .env.local
# 2. Fill in the required credentials below.
# 3. For local voice agent testing with Agora ConvAI, use an HTTPS tunnel
#    (e.g., ngrok / Cloudflare Tunnel) for PROXY_URL and MCP_URL because
#    Agora cloud servers cannot reach localhost:3000 directly.
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 1. AGORA CORE CREDENTIALS (REQUIRED for Voice RTC, RTM & ConvAI Engine)
# ─────────────────────────────────────────────────────────────────────────────
# Get these from Agora Console: https://console.agora.io
# - Create a project with App ID + App Certificate (Security Mode)
AGORA_APP_ID="your_agora_app_id"
AGORA_APP_CERTIFICATE="your_agora_app_certificate"

# Agora REST API Basic Auth Credentials (for ConvAI Agent Start/Stop & Cloud Recording)
# Find in Agora Console -> RESTful API -> Add Customer Key
AGORA_CUSTOMER_KEY="your_agora_customer_key"
AGORA_CUSTOMER_SECRET="your_agora_customer_secret"

# ─────────────────────────────────────────────────────────────────────────────
# 2. LLM CONFIGURATION — Priority: Gemini 2.0 Flash → GPT-4o-mini → Agora managed
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret for authenticating requests between Agora ConvAI and /api/llm/proxy
# Generate any secure random string (e.g., `openssl rand -hex 24`)
INTERNAL_PROXY_SECRET="aura_proxy_secret_replace_with_random_string"

# OPTION A (RECOMMENDED): Google Gemini 2.0 Flash — fastest TTFT (<300ms), best for voice
# Get from: https://aistudio.google.com/app/apikey
# When set, AURA uses Gemini 2.0 Flash via Google's OpenAI-compatible endpoint.
GEMINI_API_KEY="your_gemini_api_key"

# OPTION B: OpenAI GPT-4o-mini — fallback LLM if Gemini is not configured
# Get from: https://platform.openai.com/api-keys
# If both GEMINI_API_KEY and OPENAI_API_KEY are set, Gemini is used with OpenAI as fallback.
OPENAI_API_KEY="sk-proj-your_openai_api_key"

# ─────────────────────────────────────────────────────────────────────────────
# 3. TTS CONFIGURATION — Priority: Google Journey → MiniMax → Agora managed
# ─────────────────────────────────────────────────────────────────────────────
# OPTION A (BEST QUALITY): Google Cloud TTS — Journey voices (most human-sounding)
# Get API key: https://console.cloud.google.com/apis/credentials
# Enable: Cloud Text-to-Speech API
# Voices used: en-US-Journey-F (primary), en-US-Neural2-F (fallback)
GOOGLE_TTS_API_KEY="your_google_cloud_api_key"

# OPTION B: MiniMax speech-2.6-turbo — ultra-low latency (~120ms TTFF)
# Get from: https://platform.minimaxi.com
# Used when GOOGLE_TTS_API_KEY is not set.
MINIMAX_API_KEY="your_minimax_api_key"

# NOTE: If neither TTS key is set, AURA falls back to Agora's managed MiniMax tier.
# Zero-key mode works out of the box — just set AGORA_* credentials above!

# ─────────────────────────────────────────────────────────────────────────────
# 4. ENDPOINTS FOR AGORA CONVAI CLOUD AGENT
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Agora's cloud engine calls these endpoints during active voice sessions.
# - Production: https://aura.akanksha.dev/api/llm/proxy
# - Local Dev: Use ngrok / cloudflared (e.g., https://xyz.ngrok-free.app/api/llm/proxy)
PROXY_URL="https://aura.akanksha.dev/api/llm/proxy"
MCP_URL="https://aura.akanksha.dev/api/mcp/sse"

# ─────────────────────────────────────────────────────────────────────────────
# 5. EXTERNAL INTEGRATIONS (TWO-PHASE ACTION COMMITS & PROOF)
# ─────────────────────────────────────────────────────────────────────────────
# Incoming Slack Webhook for live incident notifications and action receipts
# Create via Slack App -> Incoming Webhooks: https://api.slack.com/apps
SLACK_WEBHOOK_URL="https://example.com/slack-webhook-placeholder"

# Optional: AI Insights dashboard — Gemini API key also powers executive insights
# (uses the same GEMINI_API_KEY set in section 2 above — no extra key needed)

